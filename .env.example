# Server
PORT=8787
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=1089
DERIV_HISTORY_TICKS=20000
DERIV_POLL_MS=1000

# Assumed round-trip trading cost in percent points (0.02 = 2 bps)
COST_PCT_ROUND_TRIP=0.02

# Kill rule: stand aside when live spike-hunt after-cost WR / expectancy fails
# (soft warning only when PAPER_LEARN_MAX=1)
KILL_MIN_SAMPLES=50
KILL_MIN_WR=0.45
KILL_MIN_EXPECTANCY=0

# Maximize paper journaling so the journal learns fast (default on)
PAPER_LEARN_MAX=1
PAPER_COOLDOWN_MS=45000
PAPER_MAX_PENDING=3
SPIKE_WATCH_AGE_RATIO=0.28

# Spike-hunt entry gate (softened under PAPER_LEARN_MAX)
ENTRY_MIN_CONF=0.12
ENTRY_MIN_P500=0.05
ENTRY_MIN_AGE_RATIO=0.25
ENTRY_MAX_STOP_PCT=4
ENTRY_HARD_REGIME=0
ENTRY_HARD_FOCUS=0

# Learning knobs
FOCUS_MIN_N=8
LEVEL_TUNE_MIN_N=8
WALK_FORWARD_HOLDOUT=0.2
WALK_FORWARD_MIN_HOLDOUT=6

# Volatility 250 (1m candles)
VOL_MIN_HOLD_TICKS=180
VOL_HORIZON_TICKS=900
VOL_ENTRY_MIN_CONF=0.18
VOL_PAPER_COOLDOWN_MS=60000
VOL_PAPER_MAX_PENDING=2
VOL_CANDLE_SEC=60
