# Server
PORT=8787
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=1089
DERIV_HISTORY_TICKS=20000
DERIV_POLL_MS=1000

# Assumed round-trip trading cost in percent points (0.02 = 2 bps)
COST_PCT_ROUND_TRIP=0.02

# Kill rule: stand aside when live spike-hunt after-cost WR / expectancy fails
KILL_MIN_SAMPLES=50
KILL_MIN_WR=0.45
KILL_MIN_EXPECTANCY=0

# Spike-hunt entry gate (live journal quality filter)
ENTRY_MIN_CONF=0.22
ENTRY_MIN_P500=0.1
ENTRY_MIN_AGE_RATIO=0.35
ENTRY_MAX_STOP_PCT=2.5
# Set to 1 to hard-reject age regimes that seed/live show are clearly worse
ENTRY_HARD_REGIME=0

# Volatility 250 (1m candles)
VOL_MIN_HOLD_TICKS=180
VOL_HORIZON_TICKS=900
